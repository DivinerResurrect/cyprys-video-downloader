<Window x:Class="VideoDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VideoDownloader.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Video Downloader"
        Width="1100" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        Closing="OnClosing">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource GhostButton}"
                    Content="Update engine"
                    Command="{Binding UpdateEngineCommand}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Accent}" Margin="0,0,10,0">
                    <Path Data="M10,8 L20,14 L10,20 Z" Fill="{StaticResource Bg}"/>
                </Border>
                <TextBlock Text="Video Downloader" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     FontSize="14"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AnalyzeCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Margin="8,0,0,0"
                    Style="{StaticResource GhostButton}"
                    Content="Paste"
                    Command="{Binding PasteCommand}"/>
            <Button Grid.Column="2" Margin="8,0,0,0"
                    Style="{StaticResource AccentButton}"
                    Content="Get formats"
                    Command="{Binding AnalyzeCommand}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource Card}"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="90" CornerRadius="4" ClipToBounds="True" Background="{StaticResource Line}">
                            <Image Source="{Binding Video.ThumbnailUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Video.Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Video.Subtitle}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="16,12,16,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Quality" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Grid.Column="2" Text="Codec" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource SectionTitle}" Margin="0" HorizontalAlignment="Right"/>
                            </Grid>
                            <ListBox Style="{StaticResource FormatList}"
                                     ItemsSource="{Binding Formats}"
                                     SelectedItem="{Binding SelectedFormat}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Extension}" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CodecText}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <TextBlock Text="Paste a link to see the available formats"
                                   Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,12">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource AccentButton}"
                            Padding="24,10"
                            Content="{Binding DownloadButtonText}"
                            Command="{Binding DownloadCommand}"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Settings.OutputFolder, StringFormat='Saving to {0}'}"/>
                </DockPanel>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource LinkButton}"
                                    Content="Clear finished"
                                    Command="{Binding ClearFinishedCommand}"/>
                            <TextBlock Text="Queue" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Queue.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="state" Grid.Row="1"
                                                           Text="{Binding StatusText}"
                                                           Foreground="{StaticResource Muted}"
                                                           FontSize="12" Margin="0,2,0,6"/>
                                                <ProgressBar Grid.Row="2" Height="4" Maximum="100" BorderThickness="0"
                                                             Background="{StaticResource Line}"
                                                             Foreground="{StaticResource Accent}"
                                                             Value="{Binding Progress, Mode=OneWay}"/>
                                                <StackPanel Grid.Column="1" Grid.RowSpan="3"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="12,0,0,0">
                                                    <Button Style="{StaticResource LinkButton}" Content="Show"
                                                            Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource LinkButton}" Content="Retry"
                                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.RetryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource LinkButton}" Content="Cancel"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                                <Setter TargetName="state" Property="Foreground" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                <Setter TargetName="state" Property="Foreground" Value="{StaticResource Danger}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="DEFAULT QUALITY" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <StackPanel>
                            <RadioButton Content="Best available"
                                         IsChecked="{Binding Settings.DefaultQuality, Converter={StaticResource EqualsToBool}, ConverterParameter=Best}"/>
                            <RadioButton Content="4K (2160p)"
                                         IsChecked="{Binding Settings.DefaultQuality, Converter={StaticResource EqualsToBool}, ConverterParameter=P2160}"/>
                            <RadioButton Content="1080p Full HD"
                                         IsChecked="{Binding Settings.DefaultQuality, Converter={StaticResource EqualsToBool}, ConverterParameter=P1080}"/>
                            <RadioButton Content="720p"
                                         IsChecked="{Binding Settings.DefaultQuality, Converter={StaticResource EqualsToBool}, ConverterParameter=P720}"/>
                            <RadioButton Content="Audio only"
                                         IsChecked="{Binding Settings.DefaultQuality, Converter={StaticResource EqualsToBool}, ConverterParameter=AudioOnly}"/>
                        </StackPanel>

                        <TextBlock Text="VIDEO FORMAT" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <RadioButton Content="MP4" IsChecked="{Binding Settings.VideoContainer, Converter={StaticResource EqualsToBool}, ConverterParameter=mp4}"/>
                            <RadioButton Content="MKV" IsChecked="{Binding Settings.VideoContainer, Converter={StaticResource EqualsToBool}, ConverterParameter=mkv}"/>
                            <RadioButton Content="WEBM" IsChecked="{Binding Settings.VideoContainer, Converter={StaticResource EqualsToBool}, ConverterParameter=webm}"/>
                        </WrapPanel>

                        <TextBlock Text="AUDIO FORMAT" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel>
                            <RadioButton Content="MP3" IsChecked="{Binding Settings.AudioFormat, Converter={StaticResource EqualsToBool}, ConverterParameter=mp3}"/>
                            <RadioButton Content="M4A" IsChecked="{Binding Settings.AudioFormat, Converter={StaticResource EqualsToBool}, ConverterParameter=m4a}"/>
                            <RadioButton Content="WAV" IsChecked="{Binding Settings.AudioFormat, Converter={StaticResource EqualsToBool}, ConverterParameter=wav}"/>
                            <RadioButton Content="OPUS" IsChecked="{Binding Settings.AudioFormat, Converter={StaticResource EqualsToBool}, ConverterParameter=opus}"/>
                        </WrapPanel>

                        <TextBlock Text="EXTRAS" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="Download subtitles" IsChecked="{Binding Settings.DownloadSubtitles}"/>
                        <TextBox Margin="22,4,0,4"
                                 Text="{Binding Settings.SubtitleLanguages, UpdateSourceTrigger=LostFocus}"
                                 IsEnabled="{Binding Settings.DownloadSubtitles}"/>
                        <CheckBox Content="Embed thumbnail and title" IsChecked="{Binding Settings.EmbedThumbnail}"/>
                        <CheckBox Content="Whole playlist from one link" IsChecked="{Binding Settings.WholePlaylist}"/>

                        <TextBlock Text="SAVE TO" Style="{StaticResource SectionTitle}"/>
                        <TextBox IsReadOnly="True" Text="{Binding Settings.OutputFolder, Mode=OneWay}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Browse" Command="{Binding BrowseFolderCommand}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Open folder" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar DockPanel.Dock="Right"
                         Width="120" Height="4" BorderThickness="0"
                         IsIndeterminate="True"
                         Background="{StaticResource Line}"
                         Foreground="{StaticResource Accent}"
                         Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
